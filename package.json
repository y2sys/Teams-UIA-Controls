{
  "name": "teams-uia-controls",
  "version": "0.2.4",
  "description": "Windows UI AutomationでMicrosoft Teamsを制御するStream Deckプラグイン。",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:marketplace": "node scripts/build.mjs --marketplace",
    "assets:marketplace": "node scripts/marketplace-assets.mjs",
    "prepare:marketplace": "node scripts/prepare-marketplace.mjs",
    "test": "node --test tests/*.test.mjs && node scripts/test-helper.mjs",
    "test:core": "node --test tests/*.test.mjs",
    "test:helper": "node scripts/test-helper.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:runtime": "node scripts/smoke.mjs --isolated",
    "typecheck": "tsc --noEmit",
    "validate": "streamdeck validate com.meetingcontrols.streamdeck.sdPlugin",
    "pack": "streamdeck pack com.meetingcontrols.streamdeck.sdPlugin --no-update-check",
    "link": "streamdeck link com.meetingcontrols.streamdeck.sdPlugin",
    "stop": "streamdeck stop com.meetingcontrols.streamdeck",
    "restart": "streamdeck restart com.meetingcontrols.streamdeck"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.3"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.3",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "node": "24.22.1",
    "typescript": "7.0.2"
  }
}
