{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.meetingcontrols.streamdeck",
  "Name": "Teams UIA Controls",
  "Author": "y2sys",
  "Description": "Control Microsoft Teams desktop meetings from Stream Deck on Windows 11. Toggle your microphone and camera, open the sharing picker or stop sharing, and leave the meeting. Keys reflect the observed Teams state. Requires .NET 10 Desktop Runtime (Windows x64), installed separately. Japanese interface; English Teams labels are recognized but have not been verified in a live meeting. Personal Teams accounts have been tested; work and school accounts need further validation. Uses Windows UI Automation, with no Teams OAuth or app registration. Teams can briefly come to the foreground during microphone or camera operations. This independent plugin is not affiliated with Microsoft or Elgato. AI assistance was used for implementation, documentation and promotional graphics.",
  "URL": "https://github.com/y2sys/Teams-UIA-Controls",
  "Version": "0.2.4.0",
  "SDKVersion": 2,
  "CodePath": "bin/plugin.js",
  "Nodejs": {
    "Version": "24"
  },
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Icon": "imgs/plugin",
  "Category": "Teams UIA Controls",
  "CategoryIcon": "imgs/microphone",
  "Actions": [
    {
      "UUID": "com.meetingcontrols.streamdeck.microphone",
      "Name": "マイク",
      "Icon": "imgs/microphone",
      "Tooltip": "マイク",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/microphone-key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.meetingcontrols.streamdeck.camera",
      "Name": "カメラ",
      "Icon": "imgs/camera",
      "Tooltip": "カメラ",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/camera-key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.meetingcontrols.streamdeck.share",
      "Name": "画面共有",
      "Icon": "imgs/share",
      "Tooltip": "画面共有",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/share-key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.meetingcontrols.streamdeck.leave",
      "Name": "退出",
      "Icon": "imgs/leave",
      "Tooltip": "退出",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/leave-key",
          "ShowTitle": false
        }
      ]
    }
  ]
}